# Copy this file to .env.local and select the address appropriate for the device.
# Android emulator:
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080
# Android or iPhone physical device on the same LAN:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:8080
# A deployed development API may also use HTTPS:
# EXPO_PUBLIC_API_BASE_URL=https://api.example.com
